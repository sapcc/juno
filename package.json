{
  "name": "juno",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "apis/*",
    "libs/*"
  ],
  "bin": {
    "juno": "./bin/juno.js"
  },
  "scripts": {
    "delete_node_modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "delete_cache": "find . -name '.npm' -type d -prune -exec rm -rf '{}' +"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@ibm/plex": "^5.2.1",
    "npm": "^10.9.3",
    "semver": "^7.7.2",
    "tailwindcss": "^3.4.17",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "es-module-lexer": "^1.7.0",
    "esbuild": "^0.28.1",
    "glob": "^10.5.0",
    "json2md": "^2.0.3"
  },
  "packageManager": "pnpm@11.18.0"
}
